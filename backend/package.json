{
  "name": "pizza-kuryer-backend",
  "version": "1.0.0",
  "description": "Pizza Kuryer: Telegram Mini App backend (Express + Telegraf + Neon PostgreSQL)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node -e \"require('./src/database/connection').initSchema().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0"
  }
}
