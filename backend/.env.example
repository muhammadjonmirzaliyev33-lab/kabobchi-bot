# --- Server ---
PORT=3000
NODE_ENV=development

# --- Telegram ---
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=Pizza_kuryer_bot
ADMIN_IDS=1027530770
# Mini App (frontend) HTTPS manzili. Frontend tayyor bo'lgach shu yerga qo'ying.
WEBAPP_URL=https://example.com
# Bo'sh qoldirilsa bot long polling rejimida ishlaydi.
# Production uchun: https://your-domain.com (webhook /telegram/webhook ga o'rnatiladi)
WEBHOOK_DOMAIN=
WEBHOOK_SECRET=

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# --- Biznes sozlamalar ---
SAUCE_PRICE=15000
DELIVERY_FEE=0
INIT_DATA_MAX_AGE=86400
CORS_ORIGIN=*
LOG_LEVEL=info

# --- To'lovlar (4-qism) ---
# 1 Telegram Star = necha so'm (Stars invoysi summasi shu kurs bo'yicha hisoblanadi)
SOM_PER_STAR=200
# Click / Payme merchant ma'lumotlari. Bo'sh bo'lsa to'lov havolasi yaratilmaydi (STUB).
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
PAYME_MERCHANT_ID=
